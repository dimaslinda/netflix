{
    "version": 2,
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "regions": ["sin1"],
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "memory": 1024,
            "maxDuration": 15
        },
        "api/migrate.php": {
            "runtime": "vercel-php@0.9.0",
            "memory": 1024,
            "maxDuration": 30
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "headers": {
                "cache-control": "public, max-age=31536000, immutable"
            },
            "dest": "/build/$1"
        },
        {
            "src": "/(favicon.ico|robots.txt|.*\\.(?:css|js|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot|ico))",
            "headers": {
                "cache-control": "public, max-age=86400, stale-while-revalidate=604800"
            },
            "dest": "/$1"
        },
        {
            "src": "/api/migrate",
            "dest": "/api/migrate.php"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "LOG_CHANNEL": "stderr",
        "CACHE_STORE": "database"
    }
}
